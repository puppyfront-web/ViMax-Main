# =============================================================================
# ViMax Platform — Environment Variables
# Copy to .env and fill in your values.
# =============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vimax:vimax@localhost:5432/vimax

# ── Redis (queue + pub/sub) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO Object Storage ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vimax-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── API Server ──────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret

# ── AI Provider API Keys ────────────────────────────────────────────────────
# Required for image generation (Doubao Seedream / Google NanoBanana)
ARK_API_KEY=your_ark_api_key_here

# ── ViMax Python Worker ─────────────────────────────────────────────────────
# Path to the parent repo containing tools/ (image/video generators)
VIMAX_ROOT=..

# ── Next.js Frontend (used by apps/web) ─────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001/trpc

# ── Local-first asset policy ────────────────────────────────────────────────
# Unclaimed generated binaries are kept server-side for this many hours before
# the sweep deletes them (metadata rows stay). 0 disables the sweep.
ASSET_SWEEP_TTL_HOURS=24
